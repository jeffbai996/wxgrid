[Unit]
Description=wxgrid — fetch the short-range regional models into the store

[Service]
Type=oneshot
WorkingDirectory=%h/local-projects/wxgrid
ExecStart=%h/local-projects/wxgrid/venv/bin/python -m wxgrid.ingest --group regional
Nice=10
IOSchedulingClass=idle
# Same 15:1 arbitration as the main pass: the API outweighs any ingest.
CPUWeight=20
IOWeight=20
# Regional grids are small next to a global one, and this unit fetches two of
# them. It has never needed the headroom the full pass gets.
MemoryHigh=1G
MemoryMax=2G
# Measured 2026-08-25, both models with a new run to fetch: hrdps 24.5 min,
# hrrr 24.9 min, so 49.4 min of work. That is the every-six-hours case where
# both have something new; a typical hourly occurrence fetches one new HRRR
# cycle and takes about half of it. The memory gate ahead of this can spend up
# to 20 min of the window before any of that starts.
#
# An earlier 45min ceiling here was set from a bad measurement: it counted only
# the interval between the first and last step written and missed the pre-render
# that follows, which for HRDPS is longer than the fetch. Measure a model from
# its first log line to its last, not from its steps.
TimeoutStartSec=2h
# The memory gate ahead of this exits 75 (EX_TEMPFAIL) when it gives up: the
# host stayed under pressure for the whole bounded wait, so this occurrence
# stands down and the next one tries. That is a deliberate deferral, not a
# breakage, and without this line systemd records it as a failed unit — which
# makes "the desktop was busy" and "the ingest is broken" indistinguishable in
# systemctl --failed, in any health check, and to whoever is reading at 03:00.
# A real failure still shows red.
SuccessExitStatus=75
