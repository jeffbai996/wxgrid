[Unit]
Description=wxgrid — fetch the latest complete run of every model into the store

[Service]
Type=oneshot
WorkingDirectory=%h/local-projects/wxgrid
ExecStart=%h/local-projects/wxgrid/venv/bin/python -m wxgrid.ingest --all
Nice=10
IOSchedulingClass=idle
# Nice alone did not protect the API: during an ingest hour a cold point read
# measured 13 s against 0.2 s quiet (2026-08-20). cgroup weights are what
# systemd actually arbitrates with — the server outweighs the ingest 15:1.
CPUWeight=20
IOWeight=20
MemoryHigh=2G
MemoryMax=3G
TimeoutStartSec=3h
