[Unit]
Description=wxgrid — fetch the ensemble into the store

[Service]
Type=oneshot
WorkingDirectory=%h/local-projects/wxgrid
ExecStart=%h/local-projects/wxgrid/venv/bin/python -m wxgrid.ingest --group ensemble
Nice=10
IOSchedulingClass=idle
# Same 15:1 arbitration as every ingest: the API outweighs it.
CPUWeight=20
IOWeight=20
MemoryHigh=2G
MemoryMax=3G
# The ensemble is its own unit rather than the tail of the global pass. Run as
# one job, the globals came first and the ensemble inherited whatever was left
# of a shared ceiling, so a slow global run truncated GEFS and discarded the
# partial write — the same fault the split was made to remove, one tier down.
# Measured 2026-08-25: GEFS is roughly 100 min including its probability pass.
TimeoutStartSec=4h
# The memory gate ahead of this exits 75 (EX_TEMPFAIL) when it gives up: the
# host stayed under pressure for the whole bounded wait, so this occurrence
# stands down and the next one tries. That is a deliberate deferral, not a
# breakage, and without this line systemd records it as a failed unit — which
# makes "the desktop was busy" and "the ingest is broken" indistinguishable in
# systemctl --failed, in any health check, and to whoever is reading at 03:00.
# A real failure still shows red.
SuccessExitStatus=75
